# EasyVideo Change Studio Environment Configuration

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration (Optional for demo, required for cloud production)
# Get these from your Supabase project dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Configuration
# Set your OpenAI API key for live LLM change detection and script generation.
# If omitted, EasyVideo falls back to its deterministic smart semantic diff engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional Audio / TTS Generation Provider (ElevenLabs / OpenAI TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional Video Rendering Engine Integration
RENDER_PROVIDER_API_KEY=
RENDER_PROVIDER_ENDPOINT=

# Demo Mode (enables instant zero-config hiring manager exploration)
NEXT_PUBLIC_DEMO_MODE=true
